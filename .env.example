# Local development examples only. Replace before any shared deployment.
POSTGRES_DB=cheeta
POSTGRES_USER=cheeta
POSTGRES_PASSWORD=replace-with-local-password
CHEETA_ENVIRONMENT=development
CHEETA_DATABASE_URL=postgresql+psycopg://cheeta:replace-with-local-password@localhost:5432/cheeta
CHEETA_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
CHEETA_ALLOW_MOCK=false
CHEETA_IDEMPOTENCY_HOURS=24
CHEETA_JOB_MODEL_CALL_LIMIT=30
CHEETA_JOB_MODEL_TOKEN_LIMIT=300000
CHEETA_SEARCH_PROVIDER=disabled
CHEETA_JOB_SEARCH_CALL_LIMIT=20
CHEETA_RESEARCH_QUERY_LIMIT=2
CHEETA_SEARCH_RESULT_LIMIT=5
# Pi A03 requires a published pi-research v1 rule. Keep disabled until configured.
CHEETA_A03_WEB_BACKEND=disabled
CHEETA_A03_PLUGIN_PROVIDER=brave
CHEETA_A03_MAX_TURNS=16
CHEETA_A03_MAX_SEARCHES=12
CHEETA_A03_MAX_PAGES=12
CHEETA_A03_PER_OBJECT_SEARCHES=3
CHEETA_A03_MAX_SECONDS=300
# CHEETA_A03_PLUGIN_API_KEY=replace-with-selected-search-provider-key
# CHEETA_A03_FETCH_ENDPOINT=https://replace-with-authorized-bridge.invalid/v1/read
# Optional normalized HTTP search adapter. Replace placeholders before selecting http_json.
# CHEETA_SEARCH_ENDPOINT=https://replace-with-search-bridge.invalid/v1/search
# CHEETA_SEARCH_API_KEY=replace-with-search-api-key
# CHEETA_SEARCH_ALLOWED_DOMAINS=["replace-with-approved-public-domain.example"]
# Optional HTTPS structured model endpoint; placeholders only, leave unset until configured.
# CHEETA_MODEL_ENDPOINT=https://replace-with-model-host.invalid/chat/completions
# CHEETA_MODEL_NAME=replace-with-model-name
# CHEETA_MODEL_API_KEY=replace-with-model-api-key
