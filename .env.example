# Local development examples only. Replace before any shared deployment.
POSTGRES_DB=cheeta
POSTGRES_USER=cheeta
POSTGRES_PASSWORD=replace-with-local-password
CHEETA_ENVIRONMENT=development
CHEETA_DATABASE_URL=postgresql+psycopg://cheeta:replace-with-local-password@localhost:5432/cheeta
CHEETA_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CHEETA_LOCAL_USERNAME=local-reviewer
CHEETA_LOCAL_PASSWORD=replace-with-local-login-password
CHEETA_BAILIAN_API_KEY=replace-with-your-key
# Copy the exact compatible API base URL from your own Beijing workspace.
CHEETA_BAILIAN_BASE_URL=
CHEETA_BAILIAN_REGION=cn-beijing
CHEETA_BAILIAN_MODEL=qwen-plus
CHEETA_MODEL_MAX_TOKENS=2000
CHEETA_MODEL_MAX_REQUESTS_PER_CASE=24
# Optional local JSON paths; existing cases keep their bound version and hash.
CHEETA_EVALUATION_TEMPLATE_PATH=
CHEETA_REPORT_TEMPLATE_PATH=

# Optional outbound mail (SMTP over TLS). Never commit real credentials.
CHEETA_SMTP_HOST=
CHEETA_SMTP_PORT=465
CHEETA_SMTP_USERNAME=
CHEETA_SMTP_PASSWORD=
CHEETA_SMTP_SENDER=

# Optional provider-created custom voice; model must match the creation target.
CHEETA_TTS_CUSTOM_VOICE_ID=
CHEETA_TTS_CUSTOM_VOICE_LABEL=自定义音色
CHEETA_TTS_MODEL=qwen-audio-3.1-tts-flash

# Speech credentials are issued separately from Ark text credentials.
CHEETA_VOICE_PROVIDER=bailian
CHEETA_VOLC_SPEECH_API_KEY=
CHEETA_VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
CHEETA_VOLC_TTS_RESOURCE_ID=seed-tts-2.0
CHEETA_VOLC_CUSTOM_VOICE_RESOURCE_ID=seed-icl-2.0
# Set CHEETA_VOICE_PROVIDER=volcengine after configuring the speech key.
CHEETA_TEXT_PROVIDER=bailian
CHEETA_ARK_API_KEY=
CHEETA_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHEETA_ARK_MODEL=doubao-seed-2-1-lite-260915
CHEETA_ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215
CHEETA_ARK_EMBEDDING_API=multimodal
CHEETA_DIALOGUE_UNDERSTANDING_ENABLED=false
CHEETA_EXTRACTION_MAX_TOKENS=4000
CHEETA_RETRIEVAL_MIN_SIMILARITY=0.35
