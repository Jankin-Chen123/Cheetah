{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "query": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "limit": {
      "maximum": 5,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "allowed_domains": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Allowed Domains",
      "type": "array"
    }
  },
  "required": [
    "query",
    "limit",
    "allowed_domains"
  ],
  "title": "SearchRequest",
  "type": "object"
}
