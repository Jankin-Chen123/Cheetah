{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "object_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Object Id",
      "type": "string"
    },
    "query": {
      "maxLength": 500,
      "minLength": 2,
      "title": "Query",
      "type": "string"
    },
    "purpose": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    }
  },
  "required": [
    "object_id",
    "query",
    "purpose"
  ],
  "title": "Search",
  "type": "object"
}
