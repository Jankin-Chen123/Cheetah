# Install as a separate site in the existing host Nginx. Replace the domain
# and certificate paths; never replace the configuration of an existing site.
server {
    listen 80;
    server_name replace-with-your-domain.example;
    location /.well-known/acme-challenge/ {
        root /opt/cheetah/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name replace-with-your-domain.example;
    ssl_certificate /replace/with/fullchain.pem;
    ssl_certificate_key /replace/with/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 55m;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 650s;
        proxy_buffering off;
    }
}
